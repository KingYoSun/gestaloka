{
  "name": "gestaloka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "scripts": {
    "auth:init": "node scripts/init-auth.mjs",
    "auth:up": "pnpm auth:init && docker compose --env-file .env --env-file .env.ory -f compose.yaml -f compose.ory.yaml up -d --wait --force-recreate kratos hydra",
    "auth:stop": "docker compose --env-file .env --env-file .env.ory -f compose.yaml -f compose.ory.yaml stop kratos hydra identity-postgres",
    "test:auth": "pnpm build:server && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.auth.config.ts",
    "env:init": "node scripts/init-env.mjs",
    "llm:probe": "pnpm build:server && node --env-file=.env --import tsx scripts/probe-model.ts",
    "llm:harness-probe": "pnpm llm:probe --harness",
    "llm:compare": "pnpm build:server && node --env-file=.env --import tsx scripts/compare-reasoning.ts",
    "world:generate": "pnpm build:server && node --env-file=.env --import tsx scripts/generate-world.ts",
    "world:act": "pnpm build:server && node --env-file=.env --import tsx scripts/world-action.ts",
    "world:build": "pnpm build:server && node --env-file=.env --import tsx scripts/world-construction.ts",
    "dev": "pnpm build:server && pnpm --parallel --filter './apps/*' dev",
    "build:server": "tsc -b packages/contracts packages/server apps/api apps/worker",
    "build": "pnpm build:server && pnpm --filter @gestaloka/web build",
    "typecheck": "pnpm build:server && tsc -p apps/web/tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm build:server && tsx scripts/generate-contracts.ts",
    "generate:check": "pnpm build:server && tsx scripts/generate-contracts.ts --check",
    "test": "pnpm build:server && vitest run",
    "test:integration": "pnpm build:server && node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build:server && node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:poc": "pnpm build:server && node --env-file-if-exists=.env --import tsx tests/poc/world-runtime.ts",
    "check": "pnpm generate:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gestaloka/contracts": "workspace:*",
    "@gestaloka/server": "workspace:*",
    "@langchain/langgraph": "1.5.1",
    "@playwright/test": "1.64.1",
    "@tanstack/react-router": "1.170.45",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
