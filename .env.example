DATABASE_URL=
POSTGRES_PASSWORD=
NEO4J_URI=bolt://127.0.0.1:27687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
PORT=3000
# Model IDs are not restricted. Unknown models need context and upper price settings below.
LLM_MODEL=meta/muse-ember
LLM_PROVIDER=openrouter
LLM_API=chat-completions
LLM_CONTEXT_TOKENS=1048576
LLM_INPUT_USD_PER_MILLION=0.1
LLM_CACHED_INPUT_USD_PER_MILLION=0.004
LLM_OUTPUT_USD_PER_MILLION=0.5
LLM_PRICING_DATE=2026-11-17
# Upper model for result proposals AND commit judgement. Empty inherits LLM_MODEL.
LLM_RESOLUTION_MODEL=claude-sonnet-5-5
LLM_RESOLUTION_PROVIDER=anthropic
LLM_RESOLUTION_API=messages
LLM_RESOLUTION_BASE_URL=
LLM_RESOLUTION_REASONING_EFFORT=medium
LLM_RESOLUTION_INITIAL_REASONING_EFFORT=medium
LLM_RESOLUTION_CONTEXT_TOKENS=1000000
LLM_RESOLUTION_MAX_OUTPUT_TOKENS=65536
LLM_RESOLUTION_INPUT_USD_PER_MILLION=2
LLM_RESOLUTION_CACHED_INPUT_USD_PER_MILLION=0.1
LLM_RESOLUTION_OUTPUT_USD_PER_MILLION=10
LLM_RESOLUTION_PRICING_DATE=2026-10-29
# New result/resolution operations: separate review or one combined upper-model judgement.
LLM_RESOLUTION_JUDGMENT=combined
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_REASONING_EFFORT=low
GEMINI_INITIAL_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_INITIAL_REASONING_EFFORT=low
OPENAI_API=chat-completions
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_REASONING_EFFORT=low
# OpenRouter uses the existing Chat Completions transport and its own credential.
# Ember: LLM_MODEL=meta/muse-ember, LLM_PROVIDER=openrouter, LLM_API=chat-completions.
# Set all model-specific LLM_* prices when switching an existing configuration.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_EFFORT=low
# Decision model (OpenRouter Decisions API). Empty disables it. See ADR-061.
LLM_DECISION_MODEL=
LLM_DECISION_REPEAT_THRESHOLD=0.7
# Administrator's API-spend ledger for a deployment/evaluation, not a per-user quota.
LLM_BUDGET_ID=deepseek-v4.1-flash-1017-evaluation
LLM_BUDGET_USD=40
LLM_REASONING_EFFORT=low
LLM_INITIAL_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=65536
# Optional JSON by provider:model. Unset adds no waiting. Applies across workers.
# {"gemini:YOUR_MODEL":{"concurrency":2,"requestsPerMinute":30,"tokensPerMinute":200000}}
LLM_MODEL_LIMITS=
